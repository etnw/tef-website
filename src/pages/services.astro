---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesNav from '../components/ServicesNav.astro';
import ServiceSection from '../components/ServiceSection.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<BaseLayout
  title="Services — The Engine Factory"
  description="Twelve areas of commercial work for semiconductor and deep-tech companies: market intelligence, product strategy, go-to-market, cross-border entry, cross-functional coordination, selling, competitive bids, pipeline, commercial infrastructure, business development, due diligence, and team build-out."
>
  <div class="dark-wrap">
    <section class="hero hero-compact">
      <div class="hero-inner">
        <span class="eyebrow">Services</span>
        <h1>Twelve areas of <em>commercial</em> work.</h1>
        <hr class="rule">
        <p class="hero-lede">Delivered inside the client's business by a partner working as part of the team.</p>
      </div>
    </section>
  </div>

  <main id="main">
    <div class="container">
      <p class="services-intro">Every engagement is scoped and priced individually. There are no fixed packages. Most clients need three or four of these, in sequence.</p>

      <div class="services-layout">
        <ServicesNav services={services} />
        <div class="services-body">
          {services.map((service) => <ServiceSection service={service} />)}
        </div>
      </div>

      <section class="closing-band">
        <div class="panel-inner">
          <p>Engagements are scoped and priced individually, based on stage, market, and objective.</p>
          <p class="contact-cta">
            <a href={site.booking} class="btn" target="_blank" rel="noopener">Book a call</a>
          </p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  // Marks the section currently in view in the sticky nav. Progressive enhancement:
  // without JS the nav is still a working list of anchor links.
  const links = document.querySelectorAll<HTMLAnchorElement>('.services-nav a[data-anchor]');
  const sections = [...links]
    .map((link) => document.getElementById(link.dataset.anchor!))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            const current = link.dataset.anchor === entry.target.id;
            link.classList.toggle('is-current', current);
            // On narrow screens the nav is a single sideways-scrolling row, so it
            // follows the page: the current entry is brought to the row's left edge.
            // Scrolls the row itself, never the page.
            const row = link.closest('ul');
            if (current && row && row.scrollWidth > row.clientWidth) {
              const left = link.getBoundingClientRect().left - row.getBoundingClientRect().left + row.scrollLeft;
              row.scrollTo({ left, behavior: 'smooth' });
            }
          }
        }
      },
      // Trips when a section crosses the upper third, so the highlight tracks the
      // heading the reader is actually on rather than whatever is merely visible.
      { rootMargin: '-20% 0px -70% 0px' }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
