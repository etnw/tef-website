{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tef-website",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  },
  // Non-production branch builds are uploaded with `wrangler versions upload`, which
  // creates a version without promoting it. This is what serves it at a preview URL.
  "preview_urls": true,
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
