---
interface Props {
  /** Adds the legal-nav modifier used by the Impressum and Datenschutz pages. */
  legal?: boolean;
}
const { legal = false } = Astro.props;

// Approach and Investors are home page anchors, not pages.
const links = [
  { href: '/services/', label: 'Services' },
  { href: '/#approach', label: 'Approach' },
  { href: '/#investors', label: 'Investors' },
  { href: '/partners/', label: 'Partners' },
  { href: '/#contact', label: 'Contact' },
];

const path = Astro.url.pathname;
---
<header class={legal ? 'nav legal-nav' : 'nav'}>
  <div class="nav-inner">
    <a href="/" class="brand" aria-current={path === '/' ? 'page' : undefined}>The Engine Factory</a>
    <nav aria-label="Primary">
      <ul>
        {links.map(({ href, label }) => {
          // Only links to a distinct page can be the current page. Approach,
          // Investors and Contact are anchors within the home page, so marking them
          // current would put aria-current="page" on three items at once. The brand
          // carries it on the home page instead.
          const target = href.split('#')[0];
          const current = !href.includes('#') && target !== '/' && path.startsWith(target);
          return (
            <li>
              <a href={href} aria-current={current ? 'page' : undefined}>{label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
