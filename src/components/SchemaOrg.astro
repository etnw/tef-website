---
import { site } from '../data/site';

// Organization markup on every page. This exists to give search engines and business
// data aggregators an unambiguous record for this domain, which is currently being
// associated with an unrelated company.
const sameAs = [site.companyLinkedin].filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  description: site.description,
  email: site.email,
  telephone: site.phoneE164,
  logo: new URL(site.ogImage, site.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: site.address.countryCode,
  },
  founder: {
    '@type': 'Person',
    name: site.founder,
    sameAs: [site.founderLinkedin],
  },
  ...(sameAs.length ? { sameAs } : {}),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
