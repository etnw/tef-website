---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import PartnerBio from '../../components/PartnerBio.astro';
import { getCollection } from 'astro:content';

const partners = (await getCollection('partners')).sort(
  (a, b) => a.data.order - b.data.order
);

const domainCoverage = [
  ['Automotive systems', 'Etienne Winkelmuller'],
  ['Radar and mmWave', 'Etienne Winkelmuller'],
  ['Timing', 'Etienne Winkelmuller, Rich Kapusta'],
  ['Industrial', 'Etienne Winkelmuller, Rich Kapusta'],
  ['Aerospace and defense', 'Etienne Winkelmuller'],
  ['Power and energy systems', 'Rich Kapusta'],
  ['Wireless and connectivity', 'Rich Kapusta'],
  ['Medical', 'Rich Kapusta'],
  ['High-volume consumer', 'Rich Kapusta'],
  ['Test, ATE, and OSAT', 'Michael Matauschek'],
  ['Optical inspection and yield', 'Michael Matauschek'],
];

const whatYouGet = [
  ['Deal flow beyond your own network.', 'Inbound from institutional referral channels, cross-referrals from other partners, and brand-driven inbound. Leads you would not have seen on your own.'],
  ['Clients you would otherwise turn away.', 'A prospect needs European market entry, US commercial build-out, and Asian supply chain expertise. No solo consultant covers all three. In the network you take the engagement, subcontract what you cannot deliver, and keep the client relationship.'],
  ['An analytical backbone you do not have to build.', 'Market studies, TAM and SAM modeling, competitive intelligence, and pricing benchmarks as a scoped service. You spend your time on client relationships and deal execution.'],
  ['Operational infrastructure from Day 1.', 'CRM platform, contract templates, sales enablement toolkit, client onboarding standards, methodology frameworks.'],
  ['A firm behind you, not just your name.', 'Institutional buyers are more comfortable engaging a firm with a codified methodology and a quality standard than a solo consultant with a LinkedIn profile.'],
  ['No employment trade-off.', 'You keep your own entity, your own client relationships, your own P&L. You are adding infrastructure, deal flow, and a brand to what you already do.'],
  ['You choose your commercial model.', 'Embedded retainers, market entry sprints, commissioned rep work, team build-out projects, or any mix. We do not prescribe it.'],
];

const regionCoverage = [
  ['Europe', 'Etienne Winkelmuller, Michael Matauschek'],
  ['North America', 'Rich Kapusta'],
];
---
<BaseLayout
  title="Partners — The Engine Factory"
  description="A network of independent senior semiconductor commercial operators covering Europe and North America, and what the network offers senior operators who join it."
>
  <div class="dark-wrap">
    <section class="hero hero-compact">
      <div class="hero-inner">
        <span class="eyebrow">Partners</span>
        <h1>A <em>network</em> of senior operators.</h1>
        <hr class="rule">
        <p class="hero-lede">In the room with you.</p>
      </div>
    </section>
  </div>

  <main>
    <div class="container">

      <section id="network">
        <p class="lede-para">The Engine Factory is a network of independent senior commercial operators. Each partner runs their own entity, brings their own domain expertise and customer network, and works to a shared methodology and quality standard. When an engagement needs capability beyond one partner, another partner delivers it.</p>
      </section>

      <section id="people">
        <div class="partner-mosaic">
          {partners.map((partner) => <PartnerCard partner={partner} />)}
        </div>
        {/* Full bios live after the whole row, so an open one is full width
            rather than squeezed into a single column. */}
        <div class="partner-bios">
          {partners.map((partner) => <PartnerBio partner={partner} />)}
        </div>
      </section>

      <section id="coverage">
        <span class="eyebrow">Coverage</span>
        <h2>Who covers <em>what</em>.</h2>

        <div class="coverage-tables">
          <div class="table-wrap">
            <table class="coverage-table">
              <thead>
                <tr><th scope="col">Domain</th><th scope="col">Partner</th></tr>
              </thead>
              <tbody>
                {domainCoverage.map(([domain, partner]) => (
                  <tr><th scope="row">{domain}</th><td>{partner}</td></tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="table-wrap">
            <table class="coverage-table">
              <thead>
                <tr><th scope="col">Region</th><th scope="col">Partner</th></tr>
              </thead>
              <tbody>
                {regionCoverage.map(([region, partner]) => (
                  <tr><th scope="row">{region}</th><td>{partner}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="who-this-is-for">
        <span class="eyebrow">Who this is for</span>
        <h2>You have already proven you can do this <em>alone</em>.</h2>
        <p>A senior semiconductor commercial leader with 20+ years of experience and a real customer network can operate independently. Many do. The Engine Factory is built for people who have already proven that and want to do it better.</p>
      </section>

    </div>

    <section id="what-you-get" class="oxblood-panel">
      <div class="panel-inner">
        <span class="eyebrow">What you get</span>
        <h2>Infrastructure, deal flow, and a <em>brand</em>.</h2>
        <div class="serve-list">
          {whatYouGet.map(([heading, body]) => (
            <div class="serve-item">
              <h3>{heading}</h3>
              <p>{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Progressive enhancement: the bios are rendered open, and are collapsed here
  // only once the toggle exists to reopen them.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tile-more');
  const panels = document.querySelectorAll<HTMLElement>('.partner-bio');

  panels.forEach((panel) => { panel.hidden = true; });

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = document.getElementById(button.dataset.bio!);
      if (!target) return;
      const wasOpen = !target.hidden;

      // Only one bio is open at a time, so the row never pushes far down the page.
      panels.forEach((panel) => { panel.hidden = true; });
      buttons.forEach((other) => other.setAttribute('aria-expanded', 'false'));

      if (!wasOpen) {
        target.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        target.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });
  });
</script>
