---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentSection from '../components/ContentSection.astro';
import ContactBlock from '../components/ContactBlock.astro';
import MetricBand from '../components/MetricBand.astro';
import { getEntry } from 'astro:content';
import { site } from '../data/site';

// Sections are placed explicitly rather than looped, because the bespoke "partners"
// block is interleaved between them and the order is editorial, not alphabetical.
const who = (await getEntry('sections', 'who'))!;
const offering = (await getEntry('sections', 'offering'))!;
const why = (await getEntry('sections', 'why'))!;
const approach = (await getEntry('sections', 'approach'))!;
const notDifferent = (await getEntry('sections', 'not'))!;
const investors = (await getEntry('sections', 'investors'))!;
---
<BaseLayout
  title="The Engine Factory — The commercial engine for deep-tech companies"
  description="Pipeline, pricing, customer contracts, and the team to run it. We de-risk commercial execution and compress the time between funding and first revenue for semiconductor and deep-tech companies."
>
  <div class="dark-wrap">
    <section class="hero">
      <div class="hero-inner">
        <h1>The commercial engine for <em>deep-tech</em> companies.</h1>
        <hr class="rule">
        <p class="hero-lede">Pipeline, pricing, customer contracts, and the team to run it. We de-risk commercial execution and compress the time between funding and first revenue.</p>
        <p class="hero-cta">
          <a href={site.booking} class="btn" target="_blank" rel="noopener">Book a call</a>
        </p>
      </div>
    </section>
  </div>

  <main>
    <div class="container">

      <MetricBand />

      <ContentSection section={who} />

      <ContentSection section={offering}>
        <p class="section-more"><a href="/services/">All services in detail →</a></p>
      </ContentSection>

      <section id="partners">
        <span class="eyebrow">Partners</span>
        <h2>A <em>network</em> of senior operators.</h2>
        <p>The Engine Factory is built as a network of senior semiconductor commercial operators, each independent, each bringing deep expertise in a specific market, domain, or geography. A partner in Munich who has built automotive product lines from zero. A partner in Silicon Valley who has taken a company from stealth to production and knows the venture ecosystem. When a client needs capability beyond one partner, the network delivers it.</p>
        <p class="section-more"><a href="/partners/">Meet the partners →</a></p>
      </section>

      <ContentSection section={why} />

      <ContentSection section={approach} />

      <ContentSection section={notDifferent} />

      <ContentSection section={investors} />

    </div>
  </main>

  <ContactBlock />
</BaseLayout>

<script>
  // The previous home page used #how for the approach section and #problem for a
  // section the new copy drops. Both were sent to prospects as standalone links, and a
  // fragment never reaches the server, so the remap has to happen here.
  const legacyAnchors: Record<string, string> = { how: 'approach', problem: 'who' };
  const replacement = legacyAnchors[location.hash.slice(1)];
  if (replacement) location.replace(`#${replacement}`);
</script>
