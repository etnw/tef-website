---
// Figures quoted on the home page. Each is a result delivered by a single partner,
// which the footnote makes explicit.
const metrics = [
  { value: '25+ years', label: 'in semiconductors, every partner' },
  { value: '$100M', label: 'business unit run at 25% profit before tax' },
  { value: '$0 to $10M+', label: 'product line built from zero' },
  { value: '10x', label: 'go-to-market pipeline growth in the first year' },
  { value: '$100M+', label: 'opportunity funnel created' },
  { value: '$30M+', label: 'design-in pipeline across 1,000+ target accounts' },
];
---
<section id="metrics" aria-label="Track record">
  <dl class="metric-grid">
    {metrics.map(({ value, label }) => (
      <div class="metric">
        <dt class="metric-value">{value}</dt>
        <dd class="metric-label">{label}</dd>
      </div>
    ))}
  </dl>
  <p class="metric-note">
    This is the track record of individual partners, not a network total.
    Full records on the <a href="/partners/">partners page</a>.
  </p>
</section>
