---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerCard from '../components/PartnerCard.astro';
import { getCollection } from 'astro:content';

const partners = (await getCollection('partners')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);
---
<BaseLayout
  title="Partners — The Engine Factory"
  description="The Engine Factory is a network of senior semiconductor commercial operators, each independent, each bringing deep expertise in a specific market, domain, or geography."
>
  <div class="dark-wrap">
    <section class="hero hero-compact">
      <div class="hero-inner">
        <span class="eyebrow">Partners</span>
        <h1>A <em>network</em> of senior operators.</h1>
        <hr class="rule">
        <p class="hero-lede">In the room with you.</p>
      </div>
    </section>
  </div>

  <main>
    <div class="container">

      <section id="founders">
        {partners.map((partner) => <PartnerCard partner={partner} />)}
      </section>

      <section id="join">
        <span class="eyebrow">Join us</span>
        <h2>New partners are joining in 2026.</h2>
        <p>If you are a senior commercial operator in semiconductor or deep-tech and want to know more about joining the network, <a href="/#contact">get in touch</a>.</p>
      </section>

    </div>
  </main>
</BaseLayout>
